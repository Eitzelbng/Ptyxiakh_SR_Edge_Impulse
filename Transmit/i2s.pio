

.program i2s
.side_set 3
   pull         side 0b100 [0]       
   out y,32     side 0b100 [0]  
   nop          side 0b100 [0]
   mov x,y      side 0b100 [0]
.wrap_target

   loop_ch_1:
      nop       side 0b101 [3]
   jmp x--, loop_ch_1 side 0b100[3]
   nop          side 0b101 [3]
   nop          side 0b100 [3]
   mov x,y      side 0b101 [3]
   nop          side 0b110 [3]
;==SEPERATOR==
   nop          side 0b111  [1]
   in pins, 1   side 0b111 [1]
   nop          side 0b110  [3]
   loop_ch_2:
      nop       side 0b111 [1]
      in pins,1 side 0b111 [1]
   jmp x--,  loop_ch_2 side 0b110[3]
   nop           side 0b111 [1]
   in pins,1     side 0b111 [1]
   mov x,y      side 0b100 [3]
.wrap



